# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis (Upstash — use rediss:// for TLS)
REDIS_URL="rediss://default:password@host:6380"

# Email (Gmail App Password)
GMAIL_USER="your@gmail.com"
GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
GMAIL_FROM="noreply@selfless.io"

# Telegram Bot (needed by telegram notification processor)
TELEGRAM_BOT_TOKEN="1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# API URL (used by ticket-expiry processor)
# production: API_BASE_URL="https://selfless-api.onrender.com"
API_BASE_URL="http://localhost:4000"

NODE_ENV=development
# HTTP port for the health server (Railway sets this automatically)
PORT=3001
